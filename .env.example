# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
# True only on your computer
DEBUG=
# Extra hosts, comma separated (.vercel.app, localhost and 127.0.0.1 are always allowed)
ALLOWED_HOSTS=
# Extra https origins for CSRF, comma separated (https://*.vercel.app is always trusted)
CSRF_TRUSTED_ORIGINS=

# Application connection (role library_app): runserver, tests, Vercel.
# Supabase transaction pooler; take <project_ref> and the host from the admin URL:
# postgresql://library_app.<project_ref>:<APP_DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Admin connection (postgres.<project_ref>): only for migrate and db/*.sql scripts.
# Special characters in the password must be %-encoded (e.g. [ -> %5B)
ADMIN_DATABASE_URL=

# Password that db/security.sql sets for library_app (letters and digits are easiest)
APP_DB_PASSWORD=
