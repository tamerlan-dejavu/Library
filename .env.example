# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
# True only on your computer
DEBUG=
# Extra hosts, comma separated (.vercel.app, localhost and 127.0.0.1 are always allowed)
ALLOWED_HOSTS=
# Extra https origins for CSRF, comma separated (https://*.vercel.app is always trusted)
CSRF_TRUSTED_ORIGINS=
# Supabase transaction pooler URL (port 6543); special characters in the password must be %-encoded
DATABASE_URL=
